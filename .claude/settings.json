{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm dist:*)",
      "Bash(pnpm start:*)",
      "Bash(pnpm rebuild:*)",
      "Bash(pnpm approve-builds:*)",
      "Bash(pnpm run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(stat:*)",
      "Bash(find:*)",
      "Bash(mdfind:*)",
      "Bash(mdls:*)",
      "Bash(plutil:*)",
      "Bash(codesign:*)",
      "Bash(ditto:*)",
      "Bash(iconutil:*)",
      "Bash(sips:*)",
      "Bash(qlmanage:*)",
      "Bash(open /Applications/Disk Janitor.app:*)",
      "Bash(pkill -f electron-vite.js dev)",
      "Bash(pkill -f Disk Janitor)",
      "Bash(pkill -f disk-janitor.*Electron)",
      "Read(**)",
      "Edit(src/**)",
      "Edit(resources/**)",
      "Edit(*.md)",
      "Edit(*.json)",
      "Edit(*.js)",
      "Edit(*.ts)",
      "Edit(.claude/**)",
      "Write(src/**)",
      "Write(resources/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -f:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- :*)",
      "Bash(pnpm publish:*)",
      "Write(/Applications/**)",
      "Edit(/Applications/**)"
    ]
  }
}
